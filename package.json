{
  "name": "elite-apply-extension",
  "displayName": "Elite Apply \u2014 Auto Job Applier",
  "version": "0.0.1",
  "description": "Fills job applications on LinkedIn, Indeed, company career sites and every major ATS",
  "private": true,
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "build:dev": "node scripts/build.mjs dev",
    "build:prod": "node scripts/build.mjs prod",
    "package": "plasmo package"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/chrome": "0.0.268",
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.0",
    "typescript": "5.4.5"
  },
  "manifest": {
    "name": "Elite Apply \u2014 Auto Job Applier",
    "description": "Fills job applications on LinkedIn, Indeed, company career sites and every major ATS",
    "permissions": [
      "storage",
      "alarms",
      "notifications",
      "activeTab",
      "scripting",
      "windows",
      "tabs"
    ],
    "host_permissions": [
      "https://aijobtoolkit.com/*",
      "https://www.aijobtoolkit.com/*",
      "http://localhost:3000/*"
    ]
  }
}
